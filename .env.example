# Activity tracker. Copy to .env.local for local dev, and add the same three in
# Vercel → Project → Settings → Environment Variables. Never prefix these with NEXT_PUBLIC_.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API → service_role key (secret; server only)
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the iOS Shortcut sends in the x-secret header.
# Generate one with:  openssl rand -base64 32
TRACKER_SECRET=

# "On repeat" section on the home page (top 5 songs of the last 7 days).
# Optional: without these the section is hidden.
# Last.fm → https://www.last.fm/api/account/create → "API key"
LASTFM_API_KEY=

# Your Last.fm username (the one connected to Spotify)
LASTFM_USERNAME=
